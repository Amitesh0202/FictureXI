-- FixtureXI : tables, keys and constraints (Oracle 19c+)
-- Run order: 01_schema.sql, 02_views_procs_triggers.sql, 05_seed.sql

CREATE TABLE team (
  team_id     NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  team_name   VARCHAR2(50) NOT NULL,
  short_code  VARCHAR2(4)  NOT NULL,
  CONSTRAINT uq_team_name UNIQUE (team_name),
  CONSTRAINT uq_team_code UNIQUE (short_code)
);

CREATE TABLE player (
  player_id    NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  full_name    VARCHAR2(80) NOT NULL,
  player_role  VARCHAR2(10) NOT NULL,
  team_id      NUMBER NOT NULL,
  CONSTRAINT ck_player_role CHECK (player_role IN ('BATTER','BOWLER','ALLROUNDER','KEEPER')),
  CONSTRAINT fk_player_team FOREIGN KEY (team_id) REFERENCES team (team_id)
);

CREATE TABLE venue (
  venue_id    NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  venue_name  VARCHAR2(80) NOT NULL,
  city        VARCHAR2(50) NOT NULL,
  country     VARCHAR2(50) NOT NULL,
  capacity    NUMBER(7),
  CONSTRAINT uq_venue UNIQUE (venue_name, city),
  CONSTRAINT ck_venue_capacity CHECK (capacity IS NULL OR capacity > 0)
);

CREATE TABLE tournament (
  tournament_id       NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  tournament_name     VARCHAR2(80) NOT NULL,
  start_date          DATE NOT NULL,
  end_date            DATE NOT NULL,
  days_between_rounds NUMBER(2) DEFAULT 1 NOT NULL,
  CONSTRAINT uq_tournament_name UNIQUE (tournament_name),
  CONSTRAINT ck_tournament_dates CHECK (end_date >= start_date),
  CONSTRAINT ck_round_gap CHECK (days_between_rounds >= 1)
);

CREATE TABLE tournament_team (
  tournament_id NUMBER NOT NULL,
  team_id       NUMBER NOT NULL,
  CONSTRAINT pk_tournament_team PRIMARY KEY (tournament_id, team_id),
  CONSTRAINT fk_tt_tournament FOREIGN KEY (tournament_id)
      REFERENCES tournament (tournament_id) ON DELETE CASCADE,
  CONSTRAINT fk_tt_team FOREIGN KEY (team_id) REFERENCES team (team_id)
);

CREATE TABLE cricket_match (
  match_id      NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  tournament_id NUMBER NOT NULL,
  round_no      NUMBER(3) NOT NULL,
  match_date    DATE NOT NULL,
  venue_id      NUMBER,
  team1_id      NUMBER NOT NULL,
  team2_id      NUMBER NOT NULL,
  team1_extras  NUMBER(3) DEFAULT 0 NOT NULL,
  team2_extras  NUMBER(3) DEFAULT 0 NOT NULL,
  winner_id     NUMBER,
  status        VARCHAR2(10) DEFAULT 'SCHEDULED' NOT NULL,
  CONSTRAINT ck_match_teams  CHECK (team1_id < team2_id),   -- stores each pair once; also stops a team playing itself
  CONSTRAINT ck_match_winner CHECK (winner_id IS NULL OR winner_id IN (team1_id, team2_id)),
  CONSTRAINT ck_match_status CHECK (status IN ('SCHEDULED','COMPLETED')),
  CONSTRAINT ck_match_win_status CHECK (status = 'COMPLETED' OR winner_id IS NULL),
  CONSTRAINT ck_match_extras CHECK (team1_extras >= 0 AND team2_extras >= 0),
  CONSTRAINT uq_match_pair UNIQUE (tournament_id, team1_id, team2_id),
  CONSTRAINT fk_match_tournament FOREIGN KEY (tournament_id)
      REFERENCES tournament (tournament_id) ON DELETE CASCADE,
  CONSTRAINT fk_match_team1 FOREIGN KEY (tournament_id, team1_id)
      REFERENCES tournament_team (tournament_id, team_id),
  CONSTRAINT fk_match_team2 FOREIGN KEY (tournament_id, team2_id)
      REFERENCES tournament_team (tournament_id, team_id),
  CONSTRAINT fk_match_winner FOREIGN KEY (winner_id) REFERENCES team (team_id),
  CONSTRAINT fk_match_venue  FOREIGN KEY (venue_id)  REFERENCES venue (venue_id)
);

CREATE TABLE batting (
  match_id   NUMBER NOT NULL,
  player_id  NUMBER NOT NULL,
  runs       NUMBER(3) DEFAULT 0 NOT NULL,
  balls      NUMBER(3) DEFAULT 0 NOT NULL,
  fours      NUMBER(2) DEFAULT 0 NOT NULL,
  sixes      NUMBER(2) DEFAULT 0 NOT NULL,
  how_out    VARCHAR2(10) DEFAULT 'not out' NOT NULL,
  CONSTRAINT pk_batting PRIMARY KEY (match_id, player_id),
  CONSTRAINT ck_bat_nonneg CHECK (runs >= 0 AND balls >= 0 AND fours >= 0 AND sixes >= 0),
  CONSTRAINT ck_bat_boundary CHECK (4 * fours + 6 * sixes <= runs),
  CONSTRAINT ck_bat_howout CHECK (how_out IN ('not out','bowled','caught','lbw','run out','stumped')),
  CONSTRAINT fk_bat_match  FOREIGN KEY (match_id)  REFERENCES cricket_match (match_id) ON DELETE CASCADE,
  CONSTRAINT fk_bat_player FOREIGN KEY (player_id) REFERENCES player (player_id)
);

CREATE TABLE bowling (
  match_id       NUMBER NOT NULL,
  player_id      NUMBER NOT NULL,
  overs          NUMBER(3,1) NOT NULL,
  runs_conceded  NUMBER(3) NOT NULL,
  wickets        NUMBER(2) NOT NULL,
  CONSTRAINT pk_bowling PRIMARY KEY (match_id, player_id),
  CONSTRAINT ck_bowl_wickets CHECK (wickets BETWEEN 0 AND 10),
  CONSTRAINT ck_bowl_nonneg CHECK (overs >= 0 AND runs_conceded >= 0),
  CONSTRAINT fk_bowl_match  FOREIGN KEY (match_id)  REFERENCES cricket_match (match_id) ON DELETE CASCADE,
  CONSTRAINT fk_bowl_player FOREIGN KEY (player_id) REFERENCES player (player_id)
);

-- Oracle does not index foreign keys automatically
CREATE INDEX ix_player_team      ON player (team_id);
CREATE INDEX ix_match_tournament ON cricket_match (tournament_id, round_no);
CREATE INDEX ix_match_team2      ON cricket_match (tournament_id, team2_id);
CREATE INDEX ix_bat_player       ON batting (player_id);
CREATE INDEX ix_bowl_player      ON bowling (player_id);
