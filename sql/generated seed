def innings(team, opp, mid_sql):
    """returns (batting_rows, bowling_rows, extras, total, wickets) for one innings"""
    while True:
        target = max(95, min(225, int(random.gauss(158, 24))))
        extras = random.randint(3, 12)
        bat_total = target - extras
        n_out = random.choice([5,6,6,7,7,8,8,9,10])
        nb = n_out + 1
        w = [(random.random() ** 1.3) * (1.5 - 0.1 * i) for i in range(nb)]
        runs = [int(bat_total * x / sum(w)) for x in w]
        runs[0] += bat_total - sum(runs)
        break
    rows, wk_credit = [], 0
    for i, r in enumerate(runs):
        out_how = 'not out' if i == n_out else random.choice(DISMISS)
        if out_how not in ('not out', 'run out'): wk_credit += 1
        balls = random.randint(1, 6) if r == 0 else max(1, round(r / random.uniform(0.7, 1.7)))
        fours = random.randint(0, min(r // 4, 8)) if r else 0
        sixes = random.randint(0, min((r - 4 * fours) // 6, 5)) if r else 0
        rows.append((pid(team, i), r, balls, fours, sixes, out_how))
    # bowling by 5 bowlers of the opposition (indices 6..10), 4 overs each
    conceded = bat_total + extras
    cuts = sorted(random.sample(range(1, conceded), 4))
    parts = [b - a for a, b in zip([0] + cuts, cuts + [conceded])]
    wk = [0] * 5
    for _ in range(wk_credit): wk[random.randrange(5)] += 1
    bowl = [(pid(opp, 6 + k), 4, parts[k], wk[k]) for k in range(5)]
    return rows, bowl, extras, bat_total + extras, n_out

